<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="horizontal" android:padding="6dp">
        <LinearLayout android:id="@+id/chip_tune" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_chip_tune" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tune" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Measure" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/chip_eq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_chip_off" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/chip_eq_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EQ" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/chip_eq_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Off" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/chip_auto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_chip_off" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/chip_auto_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#FFFFFFFF" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/chip_auto_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Off" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/chip_loud" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@drawable/widget_chip_off" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/chip_loud_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loud" android:textColor="#FF2E2E2B" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/chip_loud_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Off" android:textColor="#FF2E2E2B" android:textSize="11sp" />
        </LinearLayout>
</LinearLayout>
