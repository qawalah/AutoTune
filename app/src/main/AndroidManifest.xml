<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- only for the optional AI review (api.anthropic.com), with the user's own key -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- the loud EQ's sound level mode listens to the cabin level while the EQ runs -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the TV link: the phone finds the TV on the Wi-Fi; the TV reads its own address to show it -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the phone listens; on a TV (no microphone, no touch screen) the same app plays each speaker instead -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="AutoTune"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.AutoTune">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android TV and Google TV: AutoTune plays each speaker of the home theatre for the phone -->
        <activity
            android:name=".tv.TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:banner="@drawable/tv_banner"
            android:label="AutoTune">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".audio.ApplyProfileActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="dev.autotune.action.APPLY_PROFILE" />
                <action android:name="dev.autotune.action.EQ_OFF" />
                <action android:name="dev.autotune.action.TOGGLE_EQ" />
                <action android:name="dev.autotune.action.TOGGLE_AUTO" />
                <action android:name="dev.autotune.action.NEXT_PROFILE" />
                <action android:name="dev.autotune.action.PREV_PROFILE" />
                <action android:name="dev.autotune.action.TOGGLE_LOUD" />
                <action android:name="dev.autotune.action.LOUD_ON" />
                <action android:name="dev.autotune.action.LOUD_OFF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="autotune" android:host="profile" />
            </intent-filter>
        </activity>
        <receiver android:name=".audio.PanelWidget" android:exported="true" android:label="AutoTune panel">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_panel_info" />
        </receiver>
        <receiver android:name=".audio.EqWidget" android:exported="true" android:label="AutoTune Eq">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_eq_info" />
        </receiver>
        <receiver android:name=".audio.AutoWidget" android:exported="true" android:label="AutoTune Auto">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_auto_info" />
        </receiver>
        <receiver android:name=".audio.ProfileWidget" android:exported="true" android:label="AutoTune Profile">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_profile_info" />
        </receiver>
        <receiver android:name=".audio.CompanionWidget" android:exported="true" android:label="AutoTune TV or PC">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_companion_info" />
        </receiver>
        <!-- widget taps and notification actions (explicit intents only) -->
        <receiver android:name=".audio.EqActionReceiver" android:exported="false" />
        <receiver android:name=".audio.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- an update (Obtainium) stops the app: bring the EQ back as after a reboot -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".audio.SystemEqService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's equaliser audio effect active while the user has it switched on" />
        </service>
        <!-- the TV's own EQ, kept on while the TV app is closed -->
        <service
            android:name=".tv.TvEqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's equaliser audio effect active on the TV while the user has it switched on" />
        </service>
        <!-- Quick Settings tile: the dynamic EQ on or off (class and id keep the old "loud" name) -->
        <service
            android:name=".audio.LoudTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_loud"
            android:label="Dynamic EQ"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
